# Local PostgreSQL connection. Fill in your password locally.
PGHOST=localhost
PGPORT=5432
PGDATABASE=fullstack_practice
PGUSER=postgres
PGPASSWORD=

# Generate a random secret locally. Never use the example file as a real secret.
JWT_SECRET=

# Google OAuth web client. Keep the secret on the backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:3001

# Hosted PostgreSQL connection (keep only in hosting environment).
DATABASE_URL=
# Render supplies PORT automatically. NODE_ENV=production on the hosted service.
